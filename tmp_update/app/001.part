function $(id) { 
  return document.getElementById(id); 
} 

function normalizarTexto(valor) { 
  return String(valor || "") 
    .toLowerCase() 
    .normalize("NFD") 
    .replace(/[\u0300-\u036f]/g, "") 
    .trim(); 
} 

